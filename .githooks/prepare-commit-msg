#!/bin/bash
# .githooks/prepare-commit-msg
# 커밋 메시지에 당일 로그 요약을 자동으로 추가합니다.

COMMIT_MSG_FILE="$1"
COMMIT_SOURCE="$2"

# 병합 커밋, 메시지 지정(-m), amend 등은 건드리지 않음
if [ -n "$COMMIT_SOURCE" ]; then
  exit 0
fi

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"
TODAY=$(date '+%Y-%m-%d')
LOG_FILE="$PROJECT_DIR/logs/${TODAY}.md"

if [ ! -f "$LOG_FILE" ]; then
  exit 0
fi

# 로그 내용을 커밋 메시지 하단에 추가
{
  cat "$COMMIT_MSG_FILE"
  echo ""
  echo "---"
  echo "## Activity Log (${TODAY})"
  # 섹션 헤더(## 로 시작하는 줄)와 항목(- 로 시작하는 줄)만 추출
  grep -E '^(##|- )' "$LOG_FILE"
} > "${COMMIT_MSG_FILE}.tmp"

mv "${COMMIT_MSG_FILE}.tmp" "$COMMIT_MSG_FILE"
